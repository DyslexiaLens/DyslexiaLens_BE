NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# Alternative Separate DB Config:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=dyslexialens
# DB_USER=postgres
# DB_PASSWORD=postgres

JWT_SECRET=<JWT_SECRET>
JWT_EXPIRES_IN=7d
OTP_EXPIRES_MINUTES=10
MAX_FILE_SIZE_MB=5

FRONTEND_URL=http://localhost:5173

AI_MODEL_BASE_URL=https://w0pal-testing-dicoding-ai.hf.space
AI_MODEL_API_KEY=<AI_MODEL_API_KEY>
AI_MODEL_TIMEOUT_MS=30000

# GEMINI_API_KEY=<GEMINI_API_KEY>

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=<SMTP_USER>
SMTP_PASS=<SMTP_PASSWORD>
SMTP_FROM=<SMPTP_FROM>

SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_KEY=<SUPABASE_ANON_OR_SERVICE_KEY>
SUPABASE_BUCKET=scan-results
